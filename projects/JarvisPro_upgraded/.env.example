# =====================================================================
# JARVIS PRO - optional environment configuration
# Copy to .env . Everything here is OPTIONAL: with no keys at all JARVIS
# runs fully offline on your local Ollama models.
# =====================================================================

# --- local brain (no credential required) ----------------------------
OLLAMA_HOST=http://127.0.0.1:11434

# --- optional cloud fallbacks ----------------------------------------
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
# GROQ_API_KEY=
# OPENWEATHER_API_KEY=

# --- optional setting overrides (JARVIS_ + dotted setting path) -------
# JARVIS_MODEL_CHAT=qwen3:4b
# JARVIS_MODEL_VISION=gemma3:12b
# JARVIS_MODEL_ALLOW_CLOUD=false
# JARVIS_POLICY_MODE=ask
# JARVIS_VOICE_ENABLED=true
# JARVIS_DEBUG=false

# Companion server
# JARVIS_PAIRING_SECRET=generate-a-long-random-secret
# JARVIS_SERVER_HOST=127.0.0.1
# JARVIS_SERVER_PORT=5000
# Google/GitHub/WhatsApp (never commit real values)
# GOOGLE_ACCESS_TOKEN=
# GITHUB_TOKEN=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# HOME_ASSISTANT_URL=
# HOME_ASSISTANT_TOKEN=
